# 环境变量配置
# 复制此文件为 .env 并填入真实值

# LLM（用 DeepSeek 性价比最高）
LLM_API_KEY=your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Embedding（可复用 DeepSeek 或换阿里百炼）
EMBEDDING_API_KEY=your-deepseek-api-key
EMBEDDING_BASE_URL=https://api.deepseek.com
EMBEDDING_MODEL=text-embedding-3-small

# 数据库（默认 SQLite，生产环境改 MySQL）
# SQLite: sqlite+aiosqlite:///app.db
# MySQL:  mysql+asyncmy://user:pass@localhost:3306/rag_db
DATABASE_URL=sqlite+aiosqlite:///app.db

# 向量数据库（默认本地 ChromaDB）
CHROMA_PERSIST_DIR=./chroma_data

# 检索参数
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
USE_RERANKER=true

# 端口
HOST=0.0.0.0
PORT=8000
