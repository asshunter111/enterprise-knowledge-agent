APP_NAME=Enterprise RAG Agent
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=20

CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=enterprise_docs_v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# hash: zero-download local demo; bge: BAAI/bge-small-zh-v1.5
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=384

# lexical: lightweight reranker; cross_encoder: BAAI/bge-reranker-v2-m3
RERANK_BACKEND=lexical
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
MIN_RELEVANCE_SCORE=0.05

# Recent turns fed to the multi-turn context resolver.
CONTEXT_HISTORY_TURNS=5

# Optional OpenAI-compatible model. Without it, the app returns an extractive
# answer and multi-turn rewriting falls back to the original query.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Optional protection for deployed environments.
APP_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MySQL example:
# DATABASE_URL=mysql+aiomysql://rag:password@127.0.0.1:3306/rag_db?charset=utf8mb4
